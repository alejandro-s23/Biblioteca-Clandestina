@model IEnumerable<Library.Models.Book>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Estante de Livros";
}
<link rel="stylesheet" href="css/home.css"/>

<div class="container mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="titulo-manuscrito mb-0">ACERVO</h4>
        <button class="btn btn-manuscrito btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#filtrosBiblioteca">
            <i class="bi bi-filter" id="filter"></i> FILTROS
        </button>
    </div>

    <div class="collapse mb-4" id="filtrosBiblioteca">
        <div class="card-manuscrito p-4 shadow-sm border-couro">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
            
                <div class="col-12 col-md-5">
                    <label for="searchInp" class="label-clandestino">BUSCAR TÍTULO</label>
                    <input type="text" name="searchString" value="@ViewBag.CurrentSearch" 
                           class="form-control input-clan border-start-0 border-couro" 
                           id="searchInp" placeholder="Digite o nome do livro...">
                </div>

                <div class="col-6 col-md-3">
                    <label class="label-clandestino">ORDENAR POR</label>
                    <select name="sortField" class="form-select input-clan border-couro">
                        <option value="Title" selected="@(ViewBag.CurrentSortField == "Title")">Título</option>
                        <option value="Author" selected="@(ViewBag.CurrentSortField == "Author")">Autor</option>
                        <option value="Available" selected="@(ViewBag.CurrentSortField == "Available")">Status</option>
                        <option value="Recent" selected="@(ViewBag.CurrentSortField == "Recent")">Data de Inclusão</option>
                    </select>
                </div>

                <div class="col-6 col-md-2">
                    <label class="label-clandestino">SENTIDO</label>
                    <select name="sortOrder" class="form-select input-clan border-couro">
                        <option value="asc" selected="@(ViewBag.CurrentOrder == "asc")">A-Z ↑</option>
                        <option value="desc" selected="@(ViewBag.CurrentOrder == "desc")">Z-A ↓</option>
                    </select>
                </div>

                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-clandestino-primary btn-sm flex-grow-1">APLICAR</button>
                    <a asp-action="Index" class="btn btn-clandestino-outline btn-sm">LIMPAR</a>
                </div>
            
            </form>
        </div>
    </div>
    <div class="row ">
        @foreach (var item in Model)
        {
            <div class="col-12 col-md-6 col-lg-4 mb-4">
                <div class="card card-acervo h-100">
                    <div class="card-body d-flex flex-column">

                        <h5 class="card-title fw-bold mb-1">@item.Title?.ToUpper()</h5>
                        <p class="card-text italic mb-3 col-12 text-muted">Escrito por: @item.Author</p>
                        <button type="button" class="btn-sinopse" 
                                data-titulo="@item.Title" 
                                data-sinopsia="@item.Description" 
                                onclick="abrirLivro(this)">
                            SINOPSIA
                        </button>

                        <hr style="border-top: 1px dashed var(--borda-couro); opacity: 0.4;">
                        <div class="mt-auto">
                            <div class="mb-3">
                                @if (!item.Available)
                                {
                                    <span class="status-indisponivel">✗_RESERVADO_POR_OUTREM</span>
                                }
                                else
                                {
                                    <span class="status-disponivel">✓_DISPONÍVEL_PARA_LEITURA</span>
                                }
                            </div>

                            @if (item.Available)
                            {
                                @if (ViewBag.UserHasBook)
                                {
                                    <button class="btn btn-secondary w-100" disabled title="Limite de um livro por vez">
                                        LIMITE_DE_POSSE_ATINGIDO
                                    </button>
                                }
                                else
                                {
                                    <form asp-action="Reserve" asp-route-bookId="@item.Id" method="post">
                                        <input type="hidden" name="bookId" value="@item.Id"/>
                                        <button type="submit" class="btn btn-outline-success w-100">RESERVAR_MANUSCRITO</button>
                                    </form>
                                }
                            }
                            else
                            {
                                <button class="btn btn-outline-secondary w-100" disabled>REGISTRO_OCUPADO</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<div class="modal fade" id="modalSinopse" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered ">
        <div class="modal-content modal-book-theme modal-book-rect h-100">
            
            <div class="modal-header border-0 d-flex justify-content-center position-relative">
                <h5 class="modal-title modal-book-title" id="sinopseTitulo"></h5>
                <button type="button" class="btn-close position-absolute end-0 top-0 m-3" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body modal-book-body" id="sinopseConteudo">
            </div>

            <div class="modal-footer border-0 justify-content-center pb-4">
                <small class="text-muted italic">Biblioteca Clandestina - Jaguarão/RS</small>
            </div>
        </div>
    </div>
</div>