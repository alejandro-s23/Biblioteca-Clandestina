    <div class="card card-manuscrito mb-5">
        <table class="table table-sm table table-hover italic">
            <thead>
            <tr>
                <th>NOME</th>
                <th>MATRÍCULA</th>
                <th>AÇÃO</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Users != null)
            {
                foreach (var user in Model.Users)
                {

                    <tr>

                        <td>@user.FirstName @user.LastName</td>
                        <td>@user.Registration</td>
                        <td>
                            <a onclick="openDetails('@user.Id')" class="btn btn-outline-primary">DETALHES</a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
@if (Model.Users != null)
{
    foreach (var user in Model.Users)
    {
    <div id="@user.Id" class="modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-fluid">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">ENTREVISTA: @user.FirstName</h5>
                    <button type="button" class="btn-close" onclick="closeDetails('@user.Id')" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="container">
                        <table class="table table-hover italic">
                            <thead>
                            <tr>
                                <th>PERGUNTADO</th>
                                <th>RESPONDIDO</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <td>NOME COMPLETO</td>
                                <td>@user.FirstName @user.LastName</td>
                            </tr>
                            <tr>
                                <td>MATRÍCULA</td>
                                <td>@user.Registration</td>
                            </tr>
                            <tr>
                                <td>CIDADE DE RESIDÊNCIA</td>
                                <td>@user.City</td>
                            </tr>
                            <tr>
                                <td>BAIRRO</td>
                                <td>@user.District</td>
                            </tr>
                            <tr>
                                <td>ENDEREÇO</td>
                                <td>@user.Address, @user.AddressNumber</td>
                            </tr>
                            @if (!user.Complement.IsNullOrEmpty())
                            {
                                <tr>
                                    <td>COMPLEMENTO</td>
                                    <td>@user.Complement</td>
                                </tr>
                            }
                            <tr>
                                <td>TELEFONE</td>
                                <td>@user.Phone</td>
                            </tr>
                            <tr>
                                <td>CORREIO ELETRÔNICO</td>
                                <td>@user.Email</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-danger" asp-controller="Admin" asp-action="ResetPass">RESETAR SENHA</button>
                </div>
            </div>
        </div>
    </div>
    }
}