    <div class="card card-manuscrito mb-5">
        <table class="table table-sm table table-hover italic">
            <thead>
            <tr>
                <th>NOME</th>
                <th>AUTOR</th>
                <th>AÇÃO</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Users != null)
            {
                foreach (var book in Model.Books)
                {

                    <tr>
                        <td>@book.Title</td>
                        <td>@book.Author</td>
                        <td>
                            <a class="btn btn-outline-primary">DETALHES</a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
