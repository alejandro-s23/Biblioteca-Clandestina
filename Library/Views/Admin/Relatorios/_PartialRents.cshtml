    <div class="card card-manuscrito mb-5">
        <table class="table table-sm table table-hover italic">
            <thead>
            <tr>
                <th>NOME</th>
                <th>TÍTULO</th>
                <th>AÇÃO</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var rent in Model.Rents)
            {

                <tr>

                    <td>@rent.User.FirstName @rent.User.LastName</td>
                    <td>@rent.Book.Title</td>
                    <td>
                        <a onclick="openDetails('@rent.Id')" class="btn btn-outline-primary">DETALHES</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
@if (Model.Users != null)
{
    foreach (var rent in Model.Rents)
    {
    <div id="@rent.Id" class="modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-fluid">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">REGISTRO EMPRÉSTIMO</h5>
                    <button type="button" class="btn-close" onclick="closeDetails('@rent.Id')" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="container">
                        <table class="table table-hover italic">
                            <thead>
                            <tr>
                                <th>CAMPO</th>
                                <th>DADOS</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <td>PORTADOR</td>
                                <td>@rent.User.FirstName @rent.User.LastName</td>
                            </tr>
                            <tr>
                                <td>LIVRO</td>
                                <td>@rent.Book.Title</td>
                            </tr>
                            <tr>
                                <td>AUTOR</td>
                                <td>@rent.Book.Author</td>
                            </tr>
                            <tr>
                                <td>DATA DO EMPRÉSTIMO</td>
                                <td>@rent.RentDate</td>
                            </tr>
                            <tr>
                                <td>DIAS FORA</td>
                                <td>@rent.RentTimeDays</td>
                            </tr>
                            @if (@rent.ReturnDate != null)
                            {
                                <tr>
                                    <td>DATA DA ENTREGA</td>
                                    <td>@rent.ReturnDate</td>
                                </tr>
                            }
                            <tr>
                                <td>RETORNO PREVISTO</td>
                                <td>@rent.ExpectedReturnDate</td>
                            </tr>
                            
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-primary" onclick="closeDetails('@rent.Id')">FECHAR</button>
                </div>
            </div>
        </div>
    </div>
    }
}