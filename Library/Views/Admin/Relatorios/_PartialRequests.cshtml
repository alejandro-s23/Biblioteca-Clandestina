    <div class="card card-manuscrito mb-5">
        <h4 class="titulo-manuscrito">PETIÇÕES DE REGISTRO</h4>
        <table class="table table-sm table table-hover italic">
            <thead>
            <tr>
                <th>NOME</th>
                <th>CRIADA</th>
                <th>AÇÃO</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var request in Model.SignUpRequests)
            {

                <tr>

                    <td>@request.User.FirstName @request.User.LastName</td>
                    <td>@request.CreatedAt</td>
                    <td>
                        <a onclick="openDetails('@request.Id')" class="btn btn-outline-primary">DETALHES</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="card card-manuscrito mb-5">
        <div class="align-items-center">
            <h4 class="titulo-manuscrito">PETIÇÕES DE DEVOLUÇÃO DE LIVROS</h4>
        </div>
        <table class="table table-sm table table-hover italic">
            <thead>
            <tr>
                <th>NOME</th>
                <th>CRIADA</th>
                <th>AÇÃO</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var request in Model.ReturnsRequests)
            {
                <tr>

                    <td>@request.User.FirstName @request.User.LastName</td>
                    <td>@request.CreatedAt</td>
                    <td>
                        <a onclick="openDetails('@request.Id')" class="btn btn-outline-primary">DETALHES</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
@if (Model.Users != null)
{
    @foreach (var request in Model.ReturnsRequests)
    {
    <div id="@request.Id" class="modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-fluid">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">SOLICITAÇÃO DE DEVOLUÇÃO</h5>
                    <button type="button" class="btn-close" onclick="closeDetails('@request.Id')" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="container">
                        <table class="table table-hover italic">
                            <thead>
                            <tr>
                                <th>CAMPO</th>
                                <th>REGISTRO</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <td>NOME COMPLETO</td>
                                <td>@request.User.FirstName @request.User.LastName</td>
                            </tr>
                            <tr>
                                <td>CRIADA EM:</td>
                                <td>@request.CreatedAt</td>
                            </tr>
                            <tr>
                                <td>LIVRO</td>
                                <td>@request.Body.Book.Title</td>
                            </tr>
                            <tr>
                                <td>DATA DO EMPRÉSTIMO</td>
                                <td>@request.Body.Book.CurrentRent.RentDate</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-danger" asp-controller="Admin" asp-action="ResetPass">RESETAR SENHA</button>
                </div>
            </div>
        </div>
    </div>
    }
}