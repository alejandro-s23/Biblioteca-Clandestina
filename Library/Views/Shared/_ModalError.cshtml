@if (TempData["ErrorMessage"] != null)
{
    <div id="globalModalError" class="modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-fluid">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Ocorreu um erro</h5>
                    <button type="button" class="btn-close" onclick="closeDetails('globalModalError')" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="container">
                        <p class="text-clandestino">@TempData["ErrorMessage"]</p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" onclick="closeDetails('globalModalError')" >OK</button>
                </div>
            </div>
        </div>
    </div>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            let myModal = new bootstrap.Modal(document.getElementById('globalModalError'));
            myModal.show();
        });
    </script>
}