@using Library.Extensions
@model Library.Models.ViewModel.UserProfileViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Meu Perfil";
}

@section NavItems
{
    <li class="nav-item">
        <a class="nav-link" asp-controller="@User.GetHomePage()" asp-action="Index">VOLTAR</a>
    </li>
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6">
            <div class="card card-manuscrito p-4 shadow">
                <h3 class="titulo-manuscrito border-bottom border-couro pb-2">DADOS DO PORTADOR</h3>
                <form asp-action="UpdateProfile" method="post" class="mt-3">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Matrícula (Imutável)</label>
                            <input type="text" class="form-control input-manuscrito bg-light" value="@Model.Registration" readonly />
                        </div>
                        <div class="col-md-8 mb-3">
                            <label class="form-label">Nome (Imutável)</label>
                            <input asp-for="FullName" class="form-control input-manuscrito" readonly/>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Telefone (DDD)</label>
                            <input asp-for="Phone" class="form-control input-manuscrito bg-light" value="@Model.Phone"/>
                        </div>
                        <div class="col-md-8 mb-3">
                            <label class="form-label">Email</label>
                            <input asp-for="Email" class="form-control input-manuscrito" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Bairro</label>
                            <input asp-for="District" class="form-control input-manuscrito" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Rua</label>
                            <input asp-for="Address" class="form-control input-manuscrito" />
                        </div>
                        <div class="col-md-2 mb-3">
                            <label class="form-label">Número</label>
                            <input asp-for="Number" class="form-control input-manuscrito" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-manuscrito w-100">ATUALIZAR REGISTRO</button>
                </form>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card card-manuscrito p-4 shadow border-clandestino">
                <h3 class="titulo-manuscrito border-bottom border-couro pb-2">POSSE ATUAL</h3>
                
                @if (Model.ActiveBook != null)
                {
                    <div class="text-center mt-4">
                        <h4 class="fonte-manuscrito text-clandestino">"@Model.ActiveBook.Title"</h4>
                        <p class="italic">Autor: @Model.ActiveBook.Author</p>
                        <p class="fonte-manuscrito">À @Model.RentTimeDays dias com você</p>
                        
                        <div class="mt-4 p-3 border border-dashed border-couro">
                            @if (Model.RentTimeDays > 14)
                            {
                                <h5 class="text-danger">DEVOLUÇÃO EM ATRASO!</h5>
                            }
                            <p class="small text-muted">Deseja devolver este volume às estantes?</p>
                            <form asp-action="Return" asp-route-bookId="@Model.ActiveBook.Id" method="post">
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    EFETUAR_DEVOLUÇÃO
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center mt-5">
                        <p class="italic text-muted">"Suas mãos estão vazias. Nenhum manuscrito sob sua guarda no momento."</p>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-link text-clandestino">BUSCAR NAS ESTANTES</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>