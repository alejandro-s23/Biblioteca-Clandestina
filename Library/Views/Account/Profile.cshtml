@model Library.Models.ViewModel.UserProfileViewModel
@{
    ViewData["Title"] = "Meu Perfil";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6">
            <div class="card card-manuscrito p-4 shadow">
                <h3 class="titulo-manuscrito border-bottom border-couro pb-2">DADOS_DO_PORTADOR</h3>
                <form asp-action="UpdateProfile" method="post" class="mt-3">
                    <div class="mb-3">
                        <label class="form-label">Matrícula (Imutável)</label>
                        <input type="text" class="form-control input-manuscrito bg-light" value="@Model.Registration" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nome</label>
                        <input asp-for="FirstName" class="form-control input-manuscrito" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input asp-for="Email" class="form-control input-manuscrito" />
                    </div>
                    <button type="submit" class="btn btn-manuscrito w-100">ATUALIZAR_REGISTRO</button>
                </form>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card card-manuscrito p-4 shadow border-clandestino">
                <h3 class="titulo-manuscrito border-bottom border-couro pb-2">POSSE_ATUAL</h3>
                
                @if (Model.ActiveBook != null)
                {
                    <div class="text-center mt-4">
                        <h4 class="fonte-manuscrito text-clandestino">"@Model.ActiveBook.Title"</h4>
                        <p class="italic">Autor: @Model.ActiveBook.Author</p>
                        <p class="fonte-manuscrito">À @Model.RentTimeDays dias com você</p>
                        
                        <div class="mt-4 p-3 border border-dashed border-couro">
                            <p class="small text-muted">Deseja devolver este volume aos arquivos?</p>
                            <form asp-action="ReturnBook" asp-route-bookId="@Model.ActiveBook.Id" method="post">
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    EFETUAR_DEVOLUÇÃO
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center mt-5">
                        <p class="italic text-muted">"Suas mãos estão vazias. Nenhum manuscrito sob sua guarda no momento."</p>
                        <a asp-controller="Books" asp-action="Index" class="btn btn-link text-clandestino">BUSCAR_NAS_ESTANTES</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>