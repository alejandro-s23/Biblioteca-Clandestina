@using Microsoft.EntityFrameworkCore.Metadata.Internal
@model Library.Models.ViewModel.ChangePasswordViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Trocar Senha";
}
<div class="container d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="card p-4 shadow border-couro" style="max-width: 450px; width: 100%;">
        <h3 class="fonte-manuscrito text-center mb-4 text-couro">SEGURANÇA</h3>
        
        <form asp-action="ChangePassword" method="post">
            <div class="mb-3">
                <label class="label-clandestino">SENHA ATUAL</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-couro"><i class="bi bi-key"></i></span>
                    <input type="password" name="OldPassword" class="form-control input-clan border-couro" placeholder="Digite a senha atual...">
                </div>
            </div>

            <div class="mb-4">
                <label class="label-clandestino">NOVA SENHA</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-couro"><i class="bi bi-lock"></i></span>
                    <input type="password" name="NewPassword" class="form-control input-clan border-couro" placeholder="Crie uma nova senha...">
                </div>
                <small class="text-muted d-block mt-2" style="font-size: 0.7rem;">Use pelo menos 6 caracteres misturando letras e números.</small>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-save-clandestino">CONFIRMAR ALTERAÇÃO</button>
                <a asp-action="Profile" class="btn btn-clandestino-outline">CANCELAR</a>
            </div>
        </form>
    </div>
</div>